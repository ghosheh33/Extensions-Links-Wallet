{
  "manifest_version": 3,
  "name": "محفظة الروابط",
  "version": "1.0",
  "description": "حفظ وتصنيف الروابط المهمة بسهولة.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "احفظ الرابط"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}